<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Use net8.0 assembly when running on .NET (Core), net472 assembly when running on .NET Framework -->
  <PropertyGroup>
    <JsonSchemaExtensionsTaskAssemblyPath Condition="'$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)..\tasks\net8.0\Umbraco.JsonSchema.Extensions.dll</JsonSchemaExtensionsTaskAssemblyPath>
    <JsonSchemaExtensionsTaskAssemblyPath Condition="'$(MSBuildRuntimeType)' != 'Core'">$(MSBuildThisFileDirectory)..\tasks\net472\Umbraco.JsonSchema.Extensions.dll</JsonSchemaExtensionsTaskAssemblyPath>
  </PropertyGroup>
  <UsingTask TaskName="JsonPathUpdateValue" AssemblyFile="$(JsonSchemaExtensionsTaskAssemblyPath)" />
  <UsingTask TaskName="JsonSchemaAddReferences" AssemblyFile="$(JsonSchemaExtensionsTaskAssemblyPath)" />
</Project>
