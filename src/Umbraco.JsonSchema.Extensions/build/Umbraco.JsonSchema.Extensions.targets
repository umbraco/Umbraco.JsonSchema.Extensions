<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- MSBuild 18.0+ runs on .NET 10+ (.NET Core MSBuild) or supports the .NET TaskHost (.NET Framework MSBuild) -->
    <_JsonSchemaExtensionsMSBuild18>$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))</_JsonSchemaExtensionsMSBuild18>
    <!-- net10.0 task assembly (always used by JsonSchemaGenerate, which only runs on .NET Core) -->
    <_JsonSchemaExtensionsTaskAssemblyPathCore>$(MSBuildThisFileDirectory)..\tasks\net10.0\Umbraco.JsonSchema.Extensions.dll</_JsonSchemaExtensionsTaskAssemblyPathCore>
    <!-- Runtime-appropriate task assembly: net10.0 on .NET Core MSBuild 18.0+, netstandard2.0 otherwise -->
    <_JsonSchemaExtensionsTaskAssemblyPath>$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Umbraco.JsonSchema.Extensions.dll</_JsonSchemaExtensionsTaskAssemblyPath>
    <_JsonSchemaExtensionsTaskAssemblyPath Condition="'$(MSBuildRuntimeType)' == 'Core' and '$(_JsonSchemaExtensionsMSBuild18)' == 'true'">$(_JsonSchemaExtensionsTaskAssemblyPathCore)</_JsonSchemaExtensionsTaskAssemblyPath>
  </PropertyGroup>
  <UsingTask TaskName="JsonPathUpdateValue" AssemblyFile="$(_JsonSchemaExtensionsTaskAssemblyPath)" />
  <UsingTask TaskName="JsonSchemaAddReferences" AssemblyFile="$(_JsonSchemaExtensionsTaskAssemblyPath)" />
  <!-- JsonSchemaGenerate: in-process on .NET Core MSBuild 18.0+ -->
  <UsingTask TaskName="JsonSchemaGenerate" AssemblyFile="$(_JsonSchemaExtensionsTaskAssemblyPathCore)" Condition="'$(MSBuildRuntimeType)' == 'Core' and '$(_JsonSchemaExtensionsMSBuild18)' == 'true'" />
  <!-- JsonSchemaGenerate: out-of-process via .NET TaskHost on .NET Framework MSBuild 18.0+ -->
  <UsingTask TaskName="JsonSchemaGenerate" AssemblyFile="$(_JsonSchemaExtensionsTaskAssemblyPathCore)" TaskFactory="TaskHostFactory" Runtime="NET" Architecture="CurrentArchitecture" Condition="'$(MSBuildRuntimeType)' == 'Full' and '$(_JsonSchemaExtensionsMSBuild18)' == 'true'" />
  <!-- JsonSchemaGenerate: netstandard2.0 task that logs an error on MSBuild before 18.0 -->
  <UsingTask TaskName="JsonSchemaGenerate" AssemblyFile="$(_JsonSchemaExtensionsTaskAssemblyPath)" Condition="'$(_JsonSchemaExtensionsMSBuild18)' != 'true'" />
</Project>
